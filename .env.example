# Photopol Backend
APP_NAME=Photopol
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+psycopg://photopol:photopol@localhost:5432/photopol

# Redis
REDIS_URL=redis://localhost:6379/0
# inline = process in API (local default); queue = Arq worker
JOB_EXECUTION_MODE=inline

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3 / MinIO
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=photopol
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/photopol
S3_USE_SSL=false
USE_SIGNED_URLS=false
SIGNED_URL_EXPIRES_SECONDS=3600

# Uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Credits
INITIAL_CREDITS=50
CREDIT_COST_BACKGROUND_REMOVAL=5
CREDIT_COST_BG_PRO=8
CREDIT_COST_RESIZE=1
CREDIT_COST_CROP=1
CREDIT_COST_OBJECT_REMOVE=8
CREDIT_COST_OBJECT_REMOVE_BEST=20
CREDIT_COST_UPSCALE_2X=6
CREDIT_COST_UPSCALE_4X=14
CREDIT_COST_ENHANCE=4
CREDIT_COST_BG_REPLACE=12

# Replicate / remove.bg
REPLICATE_API_TOKEN=
REPLICATE_BG_REMOVAL_MODEL=recraft-ai/recraft-remove-background
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
REPLICATE_OBJECT_REMOVE_MODEL=cjwbw/lama
REPLICATE_ENHANCE_MODEL=nightmareai/real-esrgan
REMOVEBG_API_KEY=
# removebg | replicate | local | auto
AI_BG_PROVIDER=auto

# Stripe
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREDITS=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_CREDITS_PER_PACK=100
STRIPE_SUCCESS_URL=http://localhost:3000/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3000/billing?canceled=1
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing

# Paddle Billing (optional second provider)
PADDLE_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
PADDLE_PRICE_ID_CREDITS=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_BUSINESS_MONTHLY=
# Optional — defaults to STRIPE_* URLs when empty
PADDLE_SUCCESS_URL=
PADDLE_CANCEL_URL=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate limiting
AI_RATE_LIMIT_PER_MINUTE=10

# Guest caps (enable in prod)
GUEST_LIMITS_ENABLED=false

# fal.ai failover for upscale (optional)
FAL_KEY=
FAL_UPSCALE_MODEL=fal-ai/esrgan

# Production profile (recommended on photopol.us)
# JOB_EXECUTION_MODE=queue
# USE_SIGNED_URLS=true
# GUEST_LIMITS_ENABLED=true
# DEBUG=false
# CORS_ORIGINS=https://photopol.us
